paper/frl/*.spl
paper/frl/*.synctex.gz

# Pilot archives: 8 MB and 21 MB tarballs of the replicated-pilot run, kept
# out of git deliberately. The results archive is extracted to
# data/derived/pilot/ (derived tables and documentation only, no raw market
# JSON and no model cache), and its name, SHA-256 and pilot commit are
# recorded in PROVENANCE.csv and DATA.md. See archives/README_ARCHIVE.md.
archives/

# Optional Binance Vision licensed source archives and normalized prices.
data/raw/binance/

# Pre-revision snapshots taken before each revision round; local only, the
# history of record is git.
paper/frl/revision_backup_*/

# Collaborator's working notes on sources and analysis ideas; not an input.
/idei.docx
